# SSI Ecosystem — environment variables
# Copy this file to .env and fill in the values before running docker-compose.

# Public URLs exposed by ngrok (your static domains, including scheme)
APP_ISSUER_ENDPOINT=https://izylife-issuer.eu.ngrok.io
APP_VERIFIER_ENDPOINT=https://izylife-verifier.eu.ngrok.io

# ngrok auth token — find it at https://dashboard.ngrok.com/get-started/your-authtoken
# Not needed if you mount your local ngrok config (~/.config/ngrok/ngrok.yml) into the container.
NGROK_AUTHTOKEN=

# ngrok static domains (without scheme) — find them at https://dashboard.ngrok.com/domains
NGROK_ISSUER_DOMAIN=izylife-issuer.eu.ngrok.io
NGROK_VERIFIER_DOMAIN=izylife-verifier.eu.ngrok.io

# Keycloak admin credentials (used by the keycloak service in docker-compose)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Keycloak OIDC integration (used by ssi-issuer backend)
# KEYCLOAK_REALM must match the realm name in izylife-realm.json (default: izylife)
KEYCLOAK_REALM=izylife
KEYCLOAK_ISSUER_CLIENT_ID=ssi-issuer
# Must match the "secret" field in izylife-realm.json — change in production!
KEYCLOAK_ISSUER_CLIENT_SECRET=ssi-issuer-secret

KEYCLOAK_BASE_URL=http://keycloak:8080
